{
  "name": "toybox-trials",
  "version": "0.2.0",
  "description": "Toybox Trials — Tiny contenders. Big chaos. Miniature toy-world party game prototype.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/functional.cjs && node tests/e2e/secrets.cjs && node tests/e2e/mobile.cjs && node tests/e2e/menu.cjs",
    "server:dev": "node server/build.mjs --watch",
    "server:build": "tsc -p server/tsconfig.json && node server/build.mjs",
    "server:start": "node --enable-source-maps server-dist/index.cjs"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "pg": "^8.23.1",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.181.2",
    "ws": "^8.23.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.181.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "typescript": "5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module"
}
